# The client test bed: Arch + extra/nix with a daemon and a normal user,
# set up like the VM guest (vm/setup-guest.sh) and the package. No display: this
# checks install / run / update / remove / gc, not how apps look.
FROM docker.io/library/archlinux:base-devel
RUN pacman -Syu --noconfirm --needed nix zstd jq python hyperfine desktop-file-utils && pacman -Scc --noconfirm
# Arch's nix has no nix-users group: the daemon socket is open to every
# user. The local cache is shared like /tmp (sticky, world-writable), as
# the package's tmpfiles rule makes it (packaging/eep.tmpfiles).
RUN useradd -m tester
RUN install -d -m 1777 /var/cache/eep/local /var/cache/eep/local/nar /var/tmp/eep \
 && printf 'StoreDir: /nix/store\nWantMassQuery: 0\nPriority: 10\n' > /var/cache/eep/local/nix-cache-info \
 && printf '%s\n' 'extra-substituters = file:///var/cache/eep/local?priority=10' \
      'narinfo-cache-negative-ttl = 0' > /etc/nix/eep.conf \
 && printf '%s\n' 'experimental-features = nix-command' '!include /etc/nix/eep.conf' \
      'sandbox = false' >> /etc/nix/nix.conf
